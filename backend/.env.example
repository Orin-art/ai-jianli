DATABASE_URL=postgresql+psycopg://career:replace_with_a_random_password@localhost:55432/career
COOKIE_SECURE=false
SESSION_HOURS=8
# Docker 后端默认启用 OCR；本机开发如需 OCR，另装 requirements-ocr.txt 并准备模型。
OCR_ENABLED=false
OCR_MODEL_DIR=/opt/ocr-models
OCR_TIMEOUT_SECONDS=90
# 本机开发配置；Docker 请配置根目录 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Docker 内已自动配置；本机开发请指向已启动的本地向量服务。
RETRIEVAL_URL=http://127.0.0.1:8100
